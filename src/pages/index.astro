---
import Base from "../layouts/Base.astro";
import { branches, ladder, shown, url } from "../lib/entries";

const rungs = (await ladder()).reverse();
const grown = await branches();
const label = (e: (typeof rungs)[number]) =>
  e.data.title === e.data.name ? e.data.name : `${e.data.title} · ${e.data.name}`;
const first = rungs.find((e) => e.data.order === 1)!;
// The ladder reads top down but grows bottom up, so point readers to Α.
const start = shown(first) ? url(`${first.id}/`) : `#${first.id}`;
const written = rungs.filter((e) => e.data.status === "published").length;
---
<Base>
  <h1>Becoming</h1>
  <p class="lede">
    The universe is still being made. This is its story told one tier at a time, from Α (Alpha), where spacetime
    grows, to Ω (Omega), everything after culture. Each claim cites a Source; what is contested is marked; my own
    reading comes last, set apart.
  </p>
  <p class="start"><a href={start}>Start at the bottom, with Α (Alpha) ↓</a></p>
  <ol class="ladder" reversed aria-label={`The ladder: ${written} of 6 written`}>
    {rungs.map((e, i) => {
      const live = shown(e);
      const lit = e.data.status === "published";
      const classes = [
        "rung",
        lit ? "lit" : "dim",
        e.data.openEnded && "open",
        e.data.openEnded && (i === 0 ? "top-end" : "bottom-end"),
      ];
      return (
        <li class:list={classes} id={e.id}>
          <span class="glyph" aria-hidden="true">{e.data.order}</span>
          {live ? <a class="name" href={url(`${e.id}/`)}>{label(e)}</a> : <span class="name">{label(e)}</span>}
          <span class="line">
            {e.data.line} <span class="state">{lit ? "" : `· ${e.data.status === "draft" ? "draft" : "not written yet"}`}</span>
          </span>
          {(grown.get(e.id) ?? []).length > 0 && (
            <ul class="twigs" aria-label={`Branches of ${e.data.name}`}>
              {grown.get(e.id)!.map((b) => {
                const twigLit = b.data.status === "published";
                return (
                  <li class:list={["twig", twigLit ? "lit" : "dim"]}>
                    {live && shown(b) ? <a href={url(`${b.id}/`)}>{b.data.name}</a> : <span>{b.data.name}</span>}
                    {!twigLit && <span class="state">{b.data.status === "draft" ? "draft" : "not written yet"}</span>}
                  </li>
                );
              })}
            </ul>
          )}
        </li>
      );
    })}
  </ol>
  <p class="legend">
    <span>Plain text: Established</span>
    <span class="c">Pink: Contested</span>
    <span class="s">Gold: Stance</span>
  </p>
</Base>
