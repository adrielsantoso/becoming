---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { branches, ladder, shown, url, type Branch, type Entry } from "../lib/entries";

export async function getStaticPaths() {
  const all = await ladder();
  const grown = await branches();
  return all.filter(shown).map((entry) => {
    const near = (o: number) => all.find((e) => e.data.order === o && shown(e));
    return {
      params: { tier: entry.id },
      props: {
        entry,
        below: near(entry.data.order - 1),
        above: near(entry.data.order + 1),
        twigs: grown.get(entry.id) ?? [],
      },
    };
  });
}

interface Props { entry: Entry; below?: Entry; above?: Entry; twigs: Branch[] }
const { entry, below, above, twigs } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const day = (t: Date) => t.toISOString().slice(0, 10);
---
<Base title={d.name} description={d.line}>
  <article class="entry prose">
    <header>
      <p class="tier">Tier {d.order} of 6</p>
      <h1>{d.title === d.name ? d.name : `${d.title} · ${d.name}`}</h1>
      <p class="lede">
        {d.line}
        {d.published && <> · first published <time datetime={day(d.published)}>{day(d.published)}</time></>}
        {d.updated && <> · updated <time datetime={day(d.updated)}>{day(d.updated)}</time></>}
        {d.status === "draft" && <span class="status">draft</span>}
      </p>
    </header>
    <Content />
    {twigs.length > 0 && (
      <nav class="grown" aria-label={`Branches of ${d.name}`}>
        <p class="mark">Branches</p>
        <ul class="twigs">
          {twigs.map((b) => (
            <li class:list={["twig", b.data.status === "published" ? "lit" : "dim"]}>
              {shown(b) ? <a href={url(`${b.id}/`)}>{b.data.name}</a> : <span>{b.data.name}</span>}
              <span class="line">{b.data.line}</span>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <nav class="near" aria-label="Neighbouring tiers">
      {below ? <a href={url(`${below.id}/`)}>↓ {below.data.name}</a> : <span />}
      {above ? <a href={url(`${above.id}/`)}>{above.data.name} ↑</a> : <span />}
    </nav>
  </article>
</Base>
